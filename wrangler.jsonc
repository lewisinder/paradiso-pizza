{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paradiso-pizza",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "paradisopizza.co.nz/*",
      "zone_name": "paradisopizza.co.nz"
    },
    {
      "pattern": "www.paradisopizza.co.nz/*",
      "zone_name": "paradisopizza.co.nz"
    }
  ],
  "assets": {
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "0dc230b412a74a66b4f9b9ac7c732d81"
    }
  ],
  "observability": {
    "enabled": true
  }
}
