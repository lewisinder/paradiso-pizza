---
import "../styles/global.css";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { site as staticSite } from "@/data/site";
import { localBusinessSchema } from "@/lib/seo";
import { withBase, pathnameWithoutBase } from "@/lib/base";
import { getSiteSettings } from "@/lib/tina/data";
import { islands } from "@/lib/tina/islands";

// Every page renders through this layout, which owns the whole <head>:
// title, meta description, canonical URL, Open Graph tags, robots directive,
// and LocalBusiness structured data. Pages only supply title + description.
type Props = {
  title: string;
  description: string;
  robots?: string; // pass "noindex, nofollow" on utility pages
  // Extra JSON-LD blocks (e.g. faqSchema) a page wants to add.
  schemas?: Record<string, unknown>[];
};

const { title, description, schemas = [] } = Astro.props;

// Preview builds are never indexed - they're a working copy of the real site.
// Canonical still points at the production domain.
const isPreviewBuild = process.env.DEPLOY_TARGET === "preview";
const robots = isPreviewBuild ? "noindex, nofollow" : (Astro.props.robots ?? "index, follow");

const pathname = pathnameWithoutBase(Astro.url.pathname);
const siteResult = await getSiteSettings();
const site = siteResult.data.siteSettings;
const canonical = `${staticSite.url}${pathname === "/" ? "/" : `${pathname}/`}`;
const pageTitle = title.startsWith(site.name) ? title : `${title} | ${site.name}`;
const allSchemas = [localBusinessSchema(), ...schemas];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={withBase("/assets/favicon.png")} type="image/png" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={withBase("/sitemap.xml")} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    {allSchemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <TinaIsland name="header" wrapper={islands.header.wrapper} params={{ pathname }}>
      <Header site={site} pathname={pathname} />
    </TinaIsland>
    <main id="main">
      <slot />
    </main>
    <TinaIsland name="footer" wrapper={islands.footer.wrapper}>
      <Footer site={site} />
    </TinaIsland>

    <script>
      // Delegated handlers survive Tina's live replacement of editable regions.
      document.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return;

        const toggle = event.target.closest<HTMLButtonElement>(".nav-toggle");
        if (toggle) {
          const nav = document.getElementById("site-nav");
          const open = nav?.classList.toggle("is-open");
          toggle.setAttribute("aria-expanded", String(Boolean(open)));
          return;
        }

        if (event.target.closest("#site-nav a")) {
          const nav = document.getElementById("site-nav");
          nav?.classList.remove("is-open");
          document.querySelector<HTMLButtonElement>(".nav-toggle")?.setAttribute(
            "aria-expanded",
            "false",
          );
        }
      });
    </script>
  </body>
</html>
