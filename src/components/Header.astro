---
import { Menu } from "@lucide/astro";
import { tinaField } from "@tinacms/astro/tina-field";
import type { SiteSettingsQuery } from "../../tina/__generated__/types";
import { withBase } from "@/lib/base";

type Props = {
  site: SiteSettingsQuery["siteSettings"];
  pathname?: string;
};

const { site, pathname = "/" } = Astro.props;
const navItems = (site.nav ?? []).filter((item) => item !== null);
const isCurrent = (href: string) =>
  !href.startsWith("#") && (href.replace(/\/$/, "") || "/") === pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={withBase("/")} data-tina-field={tinaField(site, "name")}>
      {site.name}
    </a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <Menu size={22} aria-hidden="true" />
      <span class="visually-hidden">Menu</span>
    </button>
    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul>
        {navItems.map((item) => (
          <li>
            <a
              href={withBase(item.href ?? "#")}
              aria-current={isCurrent(item.href ?? "#") ? "page" : undefined}
              data-tina-field={tinaField(item)}
            >
              {item.label ?? ""}
            </a>
          </li>
        ))}
        <li>
          <a
            class="btn btn--primary nav-cta"
            href={withBase(site.primaryCta?.href ?? "#")}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span data-tina-field={tinaField(site.primaryCta, "label")}>
              {site.primaryCta?.label ?? ""}
            </span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
