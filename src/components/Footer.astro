---
import FacebookIcon from "@/components/FacebookIcon.astro";
import InstagramIcon from "@/components/InstagramIcon.astro";
import { tinaField } from "@tinacms/astro/tina-field";
import type { SiteSettingsQuery } from "../../tina/__generated__/types";
import { withBase } from "@/lib/base";

type Props = {
  site: SiteSettingsQuery["siteSettings"];
};

const { site } = Astro.props;
const year = new Date().getFullYear();
const socialItems = (site.social ?? []).filter((item) => item !== null);
const hoursItems = (site.hours ?? []).filter((item) => item !== null);
const socialIcons: Record<string, typeof FacebookIcon> = {
  facebook: FacebookIcon,
  instagram: InstagramIcon,
};
---

<footer class="site-footer" id="contact">
  <div class="container">
    <div class="footer-grid">
      <div>
        <h4 class="footer-brand" data-tina-field={tinaField(site, "name")}>{site.name}</h4>
        <span class="footer-rule" aria-hidden="true"></span>
        <p class="muted" data-tina-field={tinaField(site, "tagline")}>{site.tagline ?? ""}</p>
      </div>
      <div>
        <h4 data-tina-field={tinaField(site.footer, "findUsHeading")}>
          {site.footer?.findUsHeading ?? ""}
        </h4>
        <ul>
          <li data-tina-field={tinaField(site, "address")}>
            {site.address?.street}, {site.address?.locality}, {site.address?.region} {site.address?.postalCode}
          </li>
          {socialItems.map((item) => {
            const Icon = socialIcons[(item.label ?? "").toLowerCase()];
            return (
              <li>
                <a
                  class="social-link"
                  href={withBase(item.href ?? "#")}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-tina-field={tinaField(item)}
                >
                  {Icon && <Icon class="social-link__icon" size={18} />}
                  <span>{item.label ?? ""} updates</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
      <div>
        <h4 data-tina-field={tinaField(site.footer, "hoursHeading")}>
          {site.footer?.hoursHeading ?? ""}
        </h4>
        <ul>
          {hoursItems.map((hours, index) => (
            <li data-tina-field={tinaField(site, "hours", index)}>{hours}</li>
          ))}
        </ul>
      </div>
      <div>
        <h4 data-tina-field={tinaField(site.footer, "contactHeading")}>
          {site.footer?.contactHeading ?? ""}
        </h4>
        <ul>
          <li><a href={`tel:${site.phone ?? ""}`} data-tina-field={tinaField(site, "phoneDisplay")}>{site.phoneDisplay}</a></li>
          {site.email && (
            <li>
              <a href={`mailto:${site.email}`} data-tina-field={tinaField(site, "email")}>
                {site.email}
              </a>
            </li>
          )}
          <li>
            <a href={withBase(site.orderUrl ?? "#")} target="_blank" rel="noopener noreferrer">
              <span data-tina-field={tinaField(site.footer, "orderLinkLabel")}>
                {site.footer?.orderLinkLabel ?? ""}
              </span>
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>
        © {year} <span data-tina-field={tinaField(site, "legalName")}>{site.legalName}</span>.
        <span data-tina-field={tinaField(site.footer, "bottomNote")}>{site.footer?.bottomNote ?? ""}</span> ·
        <a
          class="footer-credit"
          href={site.footer?.designerUrl ?? "#"}
          target="_blank"
          rel="noopener noreferrer"
          data-tina-field={tinaField(site.footer, "designerLabel")}
        >
          {site.footer?.designerLabel ?? ""}
        </a> ·
        <a
          class="footer-credit"
          href={withBase("/privacy/")}
          data-tina-field={tinaField(site.footer, "privacyLabel")}
        >
          {site.footer?.privacyLabel ?? ""}
        </a>
      </span>
      <span class="footprint-trail footprint-trail--footer" aria-hidden="true">
        <span class="footprint-mark"></span>
        <span class="footprint-mark"></span>
        <span class="footprint-mark"></span>
      </span>
    </div>
  </div>
</footer>
