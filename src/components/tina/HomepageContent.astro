---
import FacebookIcon from "@/components/FacebookIcon.astro";
import InstagramIcon from "@/components/InstagramIcon.astro";
import ReviewCard from "@/components/ReviewCard.astro";
import { withBase } from "@/lib/base";
import { tinaField } from "@tinacms/astro/tina-field";
import type {
  GoogleReviewsQuery,
  HomepageQuery,
  KidsMenuQuery,
  MainMenuQuery,
  SiteSettingsQuery,
} from "../../../tina/__generated__/types";

type Props = {
  home: HomepageQuery["homepage"];
  mainMenu: MainMenuQuery["mainMenu"];
  kidsMenu: KidsMenuQuery["kidsMenu"];
  reviews: GoogleReviewsQuery["googleReviews"];
  site: SiteSettingsQuery["siteSettings"];
};

const { home, mainMenu, kidsMenu, reviews, site } = Astro.props;
const hero = home.hero;
const featuredContent = home.featured;
const menuContent = home.menuSection;
const reviewsContent = home.reviews;
const facebookContent = home.facebook;
const aboutContent = home.about;
const ctaContent = home.cta;

if (
  !hero ||
  !featuredContent ||
  !menuContent ||
  !reviewsContent ||
  !facebookContent ||
  !aboutContent ||
  !ctaContent
) {
  throw new Error("Homepage content is incomplete in TinaCMS.");
}

const compact = <T,>(items: Array<T | null> | null | undefined): T[] =>
  (items ?? []).filter((item): item is T => item !== null);

const pizzas = compact(mainMenu.pizzas);
const desserts = compact(mainMenu.desserts);
const addOns = compact(mainMenu.addOns);
const dips = compact(mainMenu.dips);
const kidsPizzas = compact(kidsMenu.kidsPizzas);
const kidsDips = compact(kidsMenu.kidsDips);
const kidsAddOns = compact(kidsMenu.kidsAddOns);
const legend = compact(mainMenu.legend);
const reviewItems = compact(reviews.reviews);
const socialItems = compact(site.social);
const photos = compact(aboutContent.photos);
const paragraphs = compact(aboutContent.paragraphs);
const titleLines = compact(hero.titleLines);
const featured = pizzas.filter((pizza) => pizza.featured);
const midpoint = Math.ceil(pizzas.length / 2);
const pizzaColumns = [pizzas.slice(0, midpoint), pizzas.slice(midpoint)];
const scrollingReviews = [...reviewItems, ...reviewItems];
const legendLabels = new Map(legend.map((entry) => [entry.code, entry.label]));
const badgeLabel = (code: string) => legendLabels.get(code) ?? code;
const facebookUrl =
  socialItems.find((item) => item.label?.toLowerCase() === "facebook")?.href ??
  "https://www.facebook.com/profile.php?id=61561287820379";
const facebookPluginSrc = `https://www.facebook.com/plugins/page.php?href=${encodeURIComponent(
  facebookUrl,
)}&tabs=timeline&width=500&height=620&small_header=true&adapt_container_width=true&hide_cover=false&show_facepile=false`;
const socialIcons: Record<string, typeof FacebookIcon> = {
  facebook: FacebookIcon,
  instagram: InstagramIcon,
};
const photoModifiers = [
  "about-photo-card--storefront",
  "about-photo-card--counter",
  "about-photo-card--napoli",
];
const menuNoteLines = (menuContent.note ?? "").split("\n").filter(Boolean);
const reviewColor = (color: string | null | undefined): "blue" | "red" | "yellow" | "green" =>
  color === "red" || color === "yellow" || color === "green" ? color : "blue";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div>
      <span class="overline" data-tina-field={tinaField(hero, "overline")}>
        {hero.overline ?? ""}
      </span>
      <h1
        class="hero-title scrawl"
        id="hero-title"
        data-tina-field={tinaField(hero, "titleLines")}
      >
        {titleLines.map((line) => <span>{line}</span>)}
      </h1>
      <p class="lead" data-tina-field={tinaField(hero, "lead")}>{hero.lead ?? ""}</p>
      <div class="hero-actions">
        <a
          class="btn btn--ghost"
          href={withBase("#menu")}
          data-tina-field={tinaField(hero, "menuButtonLabel")}
        >
          {hero.menuButtonLabel ?? ""}
        </a>
        <a
          class="btn btn--primary"
          href={withBase(site.orderUrl ?? "#")}
          target="_blank"
          rel="noopener noreferrer"
          data-tina-field={tinaField(hero, "orderButtonLabel")}
        >
          {hero.orderButtonLabel ?? ""}
        </a>
      </div>
      <div class="footprint-trail footprint-trail--hero" aria-hidden="true">
        <span class="footprint-mark"></span>
        <span class="footprint-mark"></span>
        <span class="footprint-mark"></span>
        <span class="footprint-mark"></span>
      </div>
    </div>

    <figure class="print-frame" data-tina-field={tinaField(hero, "image")}>
      <img
        src={withBase(hero.image ?? "")}
        alt={hero.imageAlt ?? ""}
        loading="eager"
        decoding="async"
      />
      {hero.imageCaption && (
        <figcaption class="print-caption" data-tina-field={tinaField(hero, "imageCaption")}>
          {hero.imageCaption}
        </figcaption>
      )}
    </figure>
  </div>
</section>

<section class="section" aria-labelledby="featured-title">
  <div class="container">
    <div class="section-heading">
      <h2
        class="scrawl"
        id="featured-title"
        data-tina-field={tinaField(featuredContent, "heading")}
      >
        {featuredContent.heading ?? ""}
      </h2>
      <p class="lead" data-tina-field={tinaField(featuredContent, "lead")}>
        {featuredContent.lead ?? ""}
      </p>
    </div>

    <div class="featured-grid">
      {featured.map((pizza) => (
        <article class="rough-card" data-tina-field={tinaField(pizza)}>
          <h3 data-tina-field={tinaField(pizza, "name")}>{pizza.name}</h3>
          <div class="card-rule" aria-hidden="true"></div>
          <p data-tina-field={tinaField(pizza, "description")}>{pizza.description ?? ""}</p>
          <div class="price-row">
            <span class="price" data-tina-field={tinaField(pizza, "price")}>{pizza.price}</span>
          </div>
          {pizza.orderUrl && (
            <a
              class="text-link order-card-link"
              href={pizza.orderUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span data-tina-field={tinaField(featuredContent, "orderLinkLabel")}>
                {featuredContent.orderLinkLabel ?? ""}
              </span>
            </a>
          )}
        </article>
      ))}
    </div>

    <div class="button-row button-row--center">
      <a
        class="btn btn--ghost"
        href={withBase("#menu")}
        data-tina-field={tinaField(featuredContent, "buttonLabel")}
      >
        {featuredContent.buttonLabel ?? ""}
      </a>
    </div>
  </div>
</section>

<section class="section section--surface" id="menu" aria-labelledby="menu-title">
  <div class="container">
    <div class="section-heading section-heading--center">
      <h2
        class="scrawl"
        id="menu-title"
        data-tina-field={tinaField(menuContent, "heading")}
      >
        {menuContent.heading ?? ""}
      </h2>
      <div class="menu-switch" role="tablist" aria-label="Choose menu">
        <button
          class="menu-switch__button is-active"
          type="button"
          role="tab"
          aria-selected="true"
          aria-controls="main-menu-panel"
          data-menu-target="main"
        >
          <span data-tina-field={tinaField(menuContent, "mainTabLabel")}>
            {menuContent.mainTabLabel ?? ""}
          </span>
        </button>
        <button
          class="menu-switch__button menu-switch__button--kids"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="kids-menu-panel"
          data-menu-target="kids"
        >
          <span data-tina-field={tinaField(menuContent, "kidsTabLabel")}>
            {menuContent.kidsTabLabel ?? ""}
          </span>
        </button>
      </div>
    </div>

    <div class="menu-panel is-active" id="main-menu-panel" role="tabpanel" data-menu-panel="main">
      <div class="menu-layout">
        <div>
          <div class="menu-category-title" data-tina-field={tinaField(menuContent, "pizzasHeading")}>
            {menuContent.pizzasHeading ?? ""}
          </div>
          <dl class="dietary-legend" aria-label="Dietary legend">
            {legend.map((entry) => (
              <div data-tina-field={tinaField(entry)}>
                <dt>{entry.code}</dt>
                <dd>{entry.label}</dd>
              </div>
            ))}
          </dl>
          <div class="menu-columns">
            {pizzaColumns.map((column) => (
              <ol class="menu-list">
                {column.map((pizza) => (
                  <li class="menu-entry" data-tina-field={tinaField(pizza)}>
                    <h3>
                      <span data-tina-field={tinaField(pizza, "name")}>{pizza.name}</span>
                      {compact(pizza.badges).map((badge) => (
                        <span class="dietary-mark" aria-label={badgeLabel(badge)}>{badge}</span>
                      ))}
                    </h3>
                    <span class="price" data-tina-field={tinaField(pizza, "price")}>{pizza.price}</span>
                    <p data-tina-field={tinaField(pizza, "description")}>{pizza.description ?? ""}</p>
                  </li>
                ))}
              </ol>
            ))}
          </div>
        </div>

        <aside class="red-board" id="desserts" aria-labelledby="desserts-title">
          <div class="red-board-section">
            <h3 id="desserts-title" data-tina-field={tinaField(menuContent, "dessertsHeading")}>
              {menuContent.dessertsHeading ?? ""}
            </h3>
            <ol class="menu-list">
              {desserts.map((item) => (
                <li class="menu-entry" data-tina-field={tinaField(item)}>
                  <h3>
                    <span data-tina-field={tinaField(item, "name")}>{item.name}</span>
                    {compact(item.badges).map((badge) => (
                      <span class="dietary-mark" aria-label={badgeLabel(badge)}>{badge}</span>
                    ))}
                  </h3>
                  <span class="price" data-tina-field={tinaField(item, "price")}>{item.price}</span>
                  <p data-tina-field={tinaField(item, "description")}>{item.description ?? ""}</p>
                </li>
              ))}
            </ol>
          </div>

          <div class="red-board-section">
            <h3 data-tina-field={tinaField(menuContent, "addOnsHeading")}>
              {menuContent.addOnsHeading ?? ""}
            </h3>
            <ol class="side-list">
              {addOns.map((item) => (
                <li data-tina-field={tinaField(item)}>
                  <span data-tina-field={tinaField(item, "name")}>{item.name}</span>{" "}
                  <span data-tina-field={tinaField(item, "price")}>{item.price}</span>
                </li>
              ))}
            </ol>
          </div>

          <div class="red-board-section">
            <h3 data-tina-field={tinaField(menuContent, "dipsHeading")}>
              {menuContent.dipsHeading ?? ""}
              {menuContent.dipsPrice && <span class="price">{menuContent.dipsPrice}</span>}
            </h3>
            <ol class="side-list">
              {dips.map((item) => (
                <li data-tina-field={tinaField(item)}>
                  <span data-tina-field={tinaField(item, "name")}>{item.name}</span>
                </li>
              ))}
            </ol>
          </div>

          {menuNoteLines.length > 0 && (
            <p class="menu-note" data-tina-field={tinaField(menuContent, "note")}>
              {menuNoteLines.map((line, index) => (
                <>{index > 0 && <br />}{line}</>
              ))}
            </p>
          )}
        </aside>
      </div>
    </div>

    <div class="menu-panel" id="kids-menu-panel" role="tabpanel" data-menu-panel="kids" hidden>
      <div class="kids-menu-sheet">
        <div class="kids-menu-sheet__masthead">
          <span data-tina-field={tinaField(menuContent, "kidsMastheadSmall")}>
            {menuContent.kidsMastheadSmall ?? ""}
          </span>
          <strong data-tina-field={tinaField(menuContent, "kidsMastheadTitle")}>
            {menuContent.kidsMastheadTitle ?? ""}
          </strong>
        </div>

        <div class="kids-menu-sheet__grid">
          <ol class="menu-list kids-menu-list">
            {kidsPizzas.map((pizza) => (
              <li class="menu-entry" data-tina-field={tinaField(pizza)}>
                <h3>
                  <span data-tina-field={tinaField(pizza, "name")}>{pizza.name}</span>
                  {compact(pizza.badges).map((badge) => (
                    <span class="dietary-mark" aria-label={badgeLabel(badge)}>{badge}</span>
                  ))}
                </h3>
                <span class="price" data-tina-field={tinaField(pizza, "price")}>{pizza.price}</span>
                <p data-tina-field={tinaField(pizza, "description")}>{pizza.description ?? ""}</p>
              </li>
            ))}
          </ol>

          <aside class="red-board kids-red-board" aria-labelledby="kids-extras-title">
            <div class="red-board-section">
              <h3 id="kids-extras-title" data-tina-field={tinaField(menuContent, "kidsDipsHeading")}>
                {menuContent.kidsDipsHeading ?? ""}
                {menuContent.kidsDipsPrice && <span class="price">{menuContent.kidsDipsPrice}</span>}
              </h3>
              <ol class="side-list">
                {kidsDips.map((item) => (
                  <li data-tina-field={tinaField(item)}>
                    <span data-tina-field={tinaField(item, "name")}>{item.name}</span>
                  </li>
                ))}
              </ol>
            </div>

            <div class="red-board-section">
              <h3 data-tina-field={tinaField(menuContent, "kidsAddOnsHeading")}>
                {menuContent.kidsAddOnsHeading ?? ""}
              </h3>
              <ol class="side-list">
                {kidsAddOns.map((item) => (
                  <li data-tina-field={tinaField(item)}>
                    <span data-tina-field={tinaField(item, "name")}>{item.name}</span>{" "}
                    <span data-tina-field={tinaField(item, "price")}>{item.price}</span>
                  </li>
                ))}
              </ol>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section reviews-section" id="reviews" aria-labelledby="reviews-title">
  <div class="container reviews-heading">
    <div>
      <span class="overline" data-tina-field={tinaField(reviewsContent, "overline")}>
        {reviewsContent.overline ?? ""}
      </span>
      <h2 class="scrawl" id="reviews-title" data-tina-field={tinaField(reviewsContent, "heading")}>
        {reviewsContent.heading ?? ""}
      </h2>
    </div>
    <div
      class="rating-stamp"
      aria-label={`Rated ${reviewsContent.score ?? ""} ${reviewsContent.countText ?? ""}`}
      data-tina-field={tinaField(home, "reviews")}
    >
      <span class="rating-stamp__score">{reviewsContent.score ?? ""}</span>
      <span class="rating-stamp__stars" aria-hidden="true">★★★★★</span>
      <span class="rating-stamp__copy">{reviewsContent.countText ?? ""}</span>
    </div>
  </div>

  <div class="reviews-marquee" aria-label="Customer reviews">
    <div class="reviews-marquee__track">
      {scrollingReviews.map((review, index) => (
        <div
          class="reviews-marquee__item"
          aria-hidden={index >= reviewItems.length ? "true" : undefined}
          data-tina-field={tinaField(review)}
        >
          <ReviewCard name={review.name} review={review.review} color={reviewColor(review.color)} />
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section facebook-section" id="facebook" aria-labelledby="facebook-title">
  <div class="container facebook-grid">
    <div class="facebook-copy">
      <span class="overline" data-tina-field={tinaField(facebookContent, "overline")}>
        {facebookContent.overline ?? ""}
      </span>
      <h2 class="scrawl" id="facebook-title" data-tina-field={tinaField(facebookContent, "heading")}>
        {facebookContent.heading ?? ""}
      </h2>
      <p class="lead" data-tina-field={tinaField(facebookContent, "lead")}>
        {facebookContent.lead ?? ""}
      </p>
      <a
        class="btn btn--ghost"
        href={withBase(facebookUrl)}
        target="_blank"
        rel="noopener noreferrer"
        data-tina-field={tinaField(facebookContent, "buttonLabel")}
      >
        {facebookContent.buttonLabel ?? ""}
      </a>
    </div>

    <div class="facebook-frame-wrap">
      <iframe
        class="facebook-feed"
        title="Latest Facebook posts from Paradiso Pizza"
        src={facebookPluginSrc}
        width="500"
        height="620"
        style="border:none;overflow:hidden"
        allowfullscreen="true"
        allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
      ></iframe>
      <p class="facebook-fallback">
        <span data-tina-field={tinaField(facebookContent, "fallbackLead")}>
          {facebookContent.fallbackLead ?? ""}
        </span>{" "}
        <a href={withBase(facebookUrl)} target="_blank" rel="noopener noreferrer">
          <span data-tina-field={tinaField(facebookContent, "fallbackLinkLabel")}>
            {facebookContent.fallbackLinkLabel ?? ""}
          </span>
        </a>.
      </p>
    </div>
  </div>
</section>

<section class="section" id="about" aria-labelledby="about-title">
  <div class="container about-grid">
    <div class="about-prints" aria-label="Photos from Paradiso Pizza">
      {photos.map((photo, index) => (
        <figure
          class={`about-photo-card ${photoModifiers[index % photoModifiers.length]}`}
          data-tina-field={tinaField(photo)}
        >
          <img src={withBase(photo.image ?? "")} alt={photo.alt ?? ""} loading="lazy" decoding="async" />
          {photo.caption && <figcaption class="print-caption">{photo.caption}</figcaption>}
        </figure>
      ))}
    </div>

    <div>
      <h2 class="scrawl" id="about-title" data-tina-field={tinaField(aboutContent, "heading")}>
        {aboutContent.heading ?? ""}
      </h2>
      {paragraphs.map((paragraph, index) => (
        <p data-tina-field={tinaField(aboutContent, "paragraphs", index)}>{paragraph}</p>
      ))}
      <div class="about-social-links">
        {socialItems.map((item) => {
          const Icon = socialIcons[(item.label ?? "").toLowerCase()];
          return (
            <a
              class="social-link about-social-link"
              href={withBase(item.href ?? "#")}
              target="_blank"
              rel="noopener noreferrer"
              data-tina-field={tinaField(item)}
            >
              {Icon && <Icon class="social-link__icon" size={20} />}
              <span>{item.label ?? ""} updates</span>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</section>

<section class="section cta-band" id="order" aria-labelledby="order-title">
  <div class="container">
    <h2 class="cta-title" id="order-title" data-tina-field={tinaField(ctaContent, "heading")}>
      {ctaContent.heading ?? ""}
    </h2>
    <p class="lead" data-tina-field={tinaField(ctaContent, "lead")}>
      {ctaContent.lead ?? ""}
    </p>
    <div class="hero-actions">
      <a
        class="btn btn--primary"
        href={withBase(site.orderUrl ?? "#")}
        target="_blank"
        rel="noopener noreferrer"
        data-tina-field={tinaField(ctaContent, "orderButtonLabel")}
      >
        {ctaContent.orderButtonLabel ?? ""}
      </a>
      <a class="btn btn--ghost" href={`tel:${site.phone ?? ""}`}>
        <span data-tina-field={tinaField(ctaContent, "callButtonLabel")}>
          {ctaContent.callButtonLabel ?? ""}
        </span>{" "}
        <span data-tina-field={tinaField(site, "phoneDisplay")}>{site.phoneDisplay ?? ""}</span>
      </a>
    </div>
    <div class="footprint-trail footprint-trail--center" aria-hidden="true">
      <span class="footprint-mark"></span>
      <span class="footprint-mark"></span>
      <span class="footprint-mark"></span>
    </div>
  </div>
</section>
