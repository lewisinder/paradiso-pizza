---
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ScrollFootprints from "@/components/ScrollFootprints.astro";
import HomepageContent from "@/components/tina/HomepageContent.astro";
import {
  getGoogleReviews,
  getHomepage,
  getMenu,
  getSiteSettings,
} from "@/lib/tina/data";
import { islands } from "@/lib/tina/islands";

const [homeResult, menuResult, reviewsResult, siteResult] = await Promise.all([
  getHomepage(true),
  getMenu(),
  getGoogleReviews(),
  getSiteSettings(),
]);

const home = homeResult.data.homepage;
const menu = menuResult.data.menu;
const reviews = reviewsResult.data.googleReviews;
const site = siteResult.data.siteSettings;
---

<BaseLayout
  title={home.seo?.title ?? site.name}
  description={home.seo?.description || site.description || ""}
>
  <ScrollFootprints />

  <TinaIsland name="homepage" wrapper={islands.homepage.wrapper} primary>
    <HomepageContent home={home} menu={menu} reviews={reviews} site={site} />
  </TinaIsland>

  <script>
    // Delegation keeps the menu tabs working after Tina replaces the live preview.
    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return;
      const button = event.target.closest<HTMLButtonElement>("[data-menu-target]");
      if (!button) return;

      const target = button.dataset.menuTarget;
      document.querySelectorAll<HTMLButtonElement>("[data-menu-target]").forEach((item) => {
        const isActive = item === button;
        item.classList.toggle("is-active", isActive);
        item.setAttribute("aria-selected", String(isActive));
      });

      document.querySelectorAll<HTMLElement>("[data-menu-panel]").forEach((panel) => {
        const isActive = panel.dataset.menuPanel === target;
        panel.classList.toggle("is-active", isActive);
        panel.hidden = !isActive;
      });
    });
  </script>
</BaseLayout>
