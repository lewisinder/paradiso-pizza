---
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PrivacyContent from "@/components/tina/PrivacyContent.astro";
import { getPrivacyPage } from "@/lib/tina/data";
import { islands } from "@/lib/tina/islands";

const result = await getPrivacyPage(true);
const privacy = result.data.privacyPage;
---

<BaseLayout title={privacy.seoTitle} description={privacy.seoDescription}>
  <TinaIsland name="privacy" wrapper={islands.privacy.wrapper} primary>
    <PrivacyContent data={privacy} />
  </TinaIsland>
</BaseLayout>
