---
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import UtilityPageContent from "@/components/tina/UtilityPageContent.astro";
import { getSiteSettings, getUtilityPage } from "@/lib/tina/data";
import { islands } from "@/lib/tina/islands";

const [pageResult, siteResult] = await Promise.all([
  getUtilityPage("not-found", true),
  getSiteSettings(),
]);
const page = pageResult.data.utilityPages;
const site = siteResult.data.siteSettings;
---

<BaseLayout
  title={page.heading ?? "Page not found"}
  description="That page doesn't exist."
  robots="noindex, nofollow"
>
  <TinaIsland
    name="utility"
    wrapper={islands.utility.wrapper}
    params={{ kind: "not-found" }}
    primary
  >
    <UtilityPageContent data={page} site={site} kind="not-found" />
  </TinaIsland>
</BaseLayout>
